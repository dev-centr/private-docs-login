// Private Docs Login. Copy to config/issuer.sdl (gitignored) and set env names.
// The listen address is where this process binds. issuer is the public URL relying parties use.
// Neither value assumes a particular host.

issuer "https://login.example.com"
groups-claim "groups"

listen {
  host "127.0.0.1"
  port 4180
}

// pem-path-env names a PEM file (Node host). pem-env names PEM text instead (a Worker secret).
// previous-jwks-env publishes the old public key for a while after a rotation.
signing-key {
  pem-path-env "PRIVATE_DOCS_LOGIN_SIGNING_KEY_PATH"
  previous-jwks-env "PRIVATE_DOCS_LOGIN_PREVIOUS_JWKS"
  kid "private-docs-login-1"
}

// Sign-in state (pending requests, one-time codes, access tokens). With the variable set, the Node
// host keeps it in that SQLite file. Unset, it is in memory and a restart drops sign-ins in progress.
state {
  sqlite-path-env "PRIVATE_DOCS_LOGIN_STATE_PATH"
}

// GitHub App named Private Docs Login, owned by this organization.
github {
  web "https://github.com"
  api "https://api.github.com"
  owner "dev-centr"
  slug "private-docs-login"
  app-id-env "PRIVATE_DOCS_LOGIN_GITHUB_APP_ID"
  client-id-env "PRIVATE_DOCS_LOGIN_GITHUB_CLIENT_ID"
  client-secret-env "PRIVATE_DOCS_LOGIN_GITHUB_CLIENT_SECRET"
}

// One block per GitLab host. Replace url for a self-managed instance.
// Opt-in is membership of opt-in-username, not every group the person belongs to.
gitlab {
  instance {
    url "https://gitlab.com"
    owner-group "dev-centr"
    opt-in-username "private-docs-login"
    client-id-env "PRIVATE_DOCS_LOGIN_GITLAB_CLIENT_ID"
    client-secret-env "PRIVATE_DOCS_LOGIN_GITLAB_CLIENT_SECRET"
  }
}

// Adding a relying party is another client block. No code change.
client {
  id "cloudflare-access"
  secret-env "PRIVATE_DOCS_LOGIN_CLIENT_CLOUDFLARE_ACCESS"
  redirect "https://<team-name>.cloudflareaccess.com/cdn-cgi/access/callback"
}

client {
  id "generic-rp"
  secret-env "PRIVATE_DOCS_LOGIN_CLIENT_GENERIC"
  redirect "https://rp.example/callback"
}
